    "postinstall": "npm run build:css && npm run check:css"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "tailwindcss": "3.4.17"
  }
}
