{
  "name": "sjn-mdcat-lms",
  "version": "1.0.0",
  "description": "SJN MDCAT LMS Pro",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "check:release": "node scripts/check-release-safety.js",
    "build:css": "tailwindcss -c tailwind.config.cjs -i ./styles/dashboard.css -o ./public/dashboard.css --minify",
